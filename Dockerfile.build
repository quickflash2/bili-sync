# 多阶段构建：从源码编译 bili-sync
# 用法: docker build -f Dockerfile.build -t bili-sync-rs-local .

# ---- 阶段1: 构建前端 ----
FROM docker.m.daocloud.io/library/node:22-alpine AS frontend

WORKDIR /build/web

# 设置 npm 镜像源为淘宝镜像，解决网络连接问题
RUN npm config set registry https://registry.npmmirror.com

# 项目主要使用 bun 作为包管理器，package-lock.json 可能不同步
# 因此使用 npm install 而非 npm ci
COPY web/package.json ./
RUN npm install --legacy-peer-deps

# npm 在 musl 平台下可选依赖安装有已知 bug，需显式安装 rollup 的 musl 平台包
# 参见: https://github.com/npm/cli/issues/4828
RUN npm install @rollup/rollup-linux-x64-musl --legacy-peer-deps --no-save || true

COPY web/ ./
RUN npm run build

# ---- 阶段2: 编译 Rust 后端 ----
FROM docker.m.daocloud.io/library/rust:1.97.0-alpine AS builder

# 设置 cargo 镜像源为国内镜像，解决网络连接问题
RUN echo '[source.crates-io]' > /root/.cargo/config.toml && \
    echo 'replace-with = "rustcc"' >> /root/.cargo/config.toml && \
    echo '[source.rustcc]' >> /root/.cargo/config.toml && \
    echo 'registry = "https://rsproxy.cn/crates.io-index"' >> /root/.cargo/config.toml

# 设置 apk 镜像源为阿里云镜像，解决网络连接问题
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

RUN apk update && apk add --no-cache \
    musl-dev \
    git \
    clang \
    llvm \
    sqlite-dev

ENV RUSTFLAGS="-C target-feature=-crt-static"

WORKDIR /build

# 拷贝完整源码与前端产物
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY --from=frontend /build/web/build/ web/build/

RUN cargo build --release -p bili_sync

# ---- 阶段3: 最小运行时镜像 ----
FROM docker.m.daocloud.io/library/alpine:3.21 AS runtime

RUN apk update && apk add --no-cache \
    ca-certificates \
    tzdata \
    ffmpeg \
    sqlite-libs

WORKDIR /app

COPY --from=builder /build/target/release/bili-sync-rs ./

ENV LANG=zh_CN.UTF-8 \
    TZ=Asia/Shanghai \
    HOME=/app \
    RUST_BACKTRACE=1 \
    RUST_LOG=None,bili_sync=info

ENTRYPOINT [ "/app/bili-sync-rs" ]

VOLUME [ "/app/.config/bili-sync" ]
